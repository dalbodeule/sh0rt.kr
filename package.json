    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.24.2",
    "nuxt": "^3.14.1592",
    "nuxt-purgecss": "^2.0.0",
    "prisma": "^5.19.1",
    "sass": "^1.79.3",
    "wrangler": "^3.78.8"
