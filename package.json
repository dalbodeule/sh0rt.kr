{
  "name": "nuxt-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build --preset=cloudflare_module",
    "dev": "nuxt dev --dotenv .env.nuxt",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
