    "@pinia/nuxt": "0.5.4",
    "@sentry/cli": "^2.36.2",
    "@sentry/vue": "^8.31.0",
    "@vee-validate/i18n": "^4.13.2",
    "@vee-validate/rules": "^4.13.2",
    "accept-language-parser": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "bulma": "^1.0.2",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.33.0",
    "node-html-parser": "^6.1.13",
    "nuxt-auth-utils": "^0.3.9",
