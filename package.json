{
  "name": "nuxt-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build --preset=cloudflare_module",
    "dev": "nuxt dev --dotenv .env.nuxt",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "create_meta": "drizzle-kit generate",
    "lint": "eslint common components layouts pages server nuxt.config.ts eslint.config.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '{common,components,layouts,middleware,pages,plugins,server}/**/*.{js,vue,ts,json}'",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "accept-language-parser": "^1.5.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "nuxt-auth-utils": "^0.5.30",
    "postal-mime": "^3.0.0",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.10",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-google-charts": "^1.1.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/turnstile": "^1.1.3",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nitro-cloudflare-dev": "^0.2.2",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.9",
    "wrangler": "^4.131.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
